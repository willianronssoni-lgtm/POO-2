class Pessoa {
    nome: string;

    constructor(nome: string) {
        this.nome = nome;
    }
}

class Aluno extends Pessoa {
    matricula: string;

    constructor(nome: string, matricula: string) {
        super(nome);
        this.matricula = matricula;
    }
}

class Professor extends Pessoa {
    disciplina: string;

    constructor(nome: string, disciplina: string) {
        super(nome);
        this.disciplina = disciplina;
    }
}

const aluno1 = new Aluno("adilson", "202601");
const professor1 = new Professor("Dra. Ana Costa", "Programação Orientada a Objetos");

console.log(`Aluno: ${aluno1.nome} | Matrícula: ${aluno1.matricula}`);
console.log(`Professor: ${professor1.nome} | Disciplina: ${professor1.disciplina}`);
